generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum TripStatus {
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String
  role               Role     @default(CUSTOMER)
  isVerified         Boolean  @default(false)
  idDocumentUrl      String?
  licenseDocumentUrl String?
  createdAt          DateTime @default(now())

  vehicles Vehicle[]
  trips    Trip[]
  bookings Booking[]
}

model Vehicle {
  id                      String   @id @default(uuid())
  providerId              String
  provider                User     @relation(fields: [providerId], references: [id])
  make                    String
  model                   String
  year                    Int
  color                   String?
  seatCapacity            Int
  photos                  String[]
  amenities               String[]
  registrationDocumentUrl String?
  createdAt               DateTime @default(now())

  trips Trip[]
}

model Trip {
  id              String     @id @default(uuid())
  providerId      String
  provider        User       @relation(fields: [providerId], references: [id])
  vehicleId       String
  vehicle         Vehicle    @relation(fields: [vehicleId], references: [id])
  originCity      String
  destinationCity String
  departureTime   DateTime
  pricePerSeat    Float
  totalSeats      Int
  seatsBooked     Int        @default(0)
  status          TripStatus @default(PUBLISHED)
  createdAt       DateTime   @default(now())

  bookings Booking[]
}

model Booking {
  id          String        @id @default(uuid())
  tripId      String
  trip        Trip          @relation(fields: [tripId], references: [id])
  customerId  String
  customer    User          @relation(fields: [customerId], references: [id])
  seatsBooked Int
  totalPrice  Float
  status      BookingStatus @default(CONFIRMED)
  createdAt   DateTime      @default(now())
}
